# انسخ إلى .env ثم عدّل القيم
# cp .env.example .env && chmod 600 .env

# --- مفاتيح مزوّدي البيانات (املأ ما لديك فقط) ---
HIBP_API_KEY=
LEAKCHECK_API_KEY=
DEHASHED_EMAIL=
DEHASHED_API_KEY=
INTELX_API_KEY=
SNUSBASE_API_KEY=
SHODAN_API_KEY=
GITHUB_TOKEN=

# --- إعدادات الخادم ---
OSINTX_HOST=127.0.0.1
OSINTX_PORT=8000
OSINTX_RELOAD=0

# اتركه فارغاً للتعطيل، أو ضع سلسلة عشوائية طويلة
# python3 -c "import secrets;print(secrets.token_urlsafe(32))"
OSINTX_TOKEN=

# --- حدود الموارد ---
# 0 = بلا حد
OSINTX_RATE_LIMIT=5
OSINTX_RATE_WINDOW=60
OSINTX_TIMEOUT=30
OSINTX_MAX_RESULTS=20000
